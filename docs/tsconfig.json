{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
  },
  "include": ["./**/*.ts", "./src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
