{
  "name": "ruri",
  "version": "0.5.0",
  "description": "A simple and fast UI framework",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akku1139/ruri.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "pnpm run typecheck && pnpm run test:basic",
    "test:basic": "node --test \"test/*.test.ts\" && node bench/docs-smoke.mjs && node bench/dom-features-check.mjs",
    "typecheck": "tsc --noEmit",
    "example:client": "pnpm run build && node examples/client/server.js",
    "example:fullstack": "pnpm run build && node examples/fullstack/server.js",
    "generate": "node scripts/generate-types.mjs",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "devDependencies": {
    "@markuplint/html-spec": "^4.18.0",
    "@types/node": "^26.0.0",
    "@webref/elements": "^2.7.1",
    "@webref/events": "^1.24.2",
    "happy-dom": "^20.11.6",
    "typescript": "^7.0.2"
  }
}
