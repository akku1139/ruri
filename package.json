{
  "name": "ruri",
  "version": "0.0.2",
  "description": "A simple and fast UI framework",
  "keywords": [],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akku1139/ruri.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "pnpm run typecheck && pnpm run test:basic",
    "test:basic": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "example:client": "pnpm run build && node examples/client/server.js",
    "example:fullstack": "pnpm run build && node examples/fullstack/server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "import": "./dist/jsx-runtime.js"
    }
  },
  "dependencies": {
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
